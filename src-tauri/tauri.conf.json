{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../web",
    "distDir": "../web",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "EBCDIC Viewer",
    "version": "2.0.1"
  },
  "tauri": {
    "allowlist": {
      "dialog": { "open": true },
      "fs": { "readFile": true, "scope": ["**"] }
    },
    "bundle": {
      "active": true,
      "identifier": "com.ebcdic-viewer",
      "icon": [
        "icons/icon.icns",
        "icons/icon.ico",
        "icons/icon.png"
      ],
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "EBCDIC Viewer",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ]
  }
}
